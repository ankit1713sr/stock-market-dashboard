{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-static.cjs",
  "installCommand": "",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/frontend/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
